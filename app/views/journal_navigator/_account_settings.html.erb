<div id="jn-account-settings" class="jn-account-settings"
     data-expand-label="<%= l(:button_jn_expand) %>"
     data-collapse-label="<%= l(:button_jn_collapse) %>"
     data-filter-placeholder="<%= l(:label_jn_file_filter_placeholder) %>"
     data-pdf-pages-one="<%= l(:label_jn_pdf_pages_one) %>"
     data-pdf-pages-other="<%= l(:label_jn_pdf_pages_other) %>"
     data-pdf-group-fallback="<%= l(:label_jn_pdf_group_fallback) %>"
     data-comment-files-one="<%= l(:label_jn_comment_files_one) %>"
     data-comment-files-other="<%= l(:label_jn_comment_files_other) %>">

  <div class="jn-settings-block" data-jn-block="collapse">
    <h4 class="jn-settings-title">
      <label>
        <input type="checkbox" id="jn-collapse-enabled" <%= 'checked' if prefs[:collapse_enabled] %>>
        <%= l(:label_jn_collapse_title) %>
      </label>
    </h4>
    <p class="jn-settings-hint"><%= l(:text_jn_collapse_hint) %></p>

    <p class="jn-settings-field">
      <label for="jn-collapse-lines">
        <%= l(:label_jn_collapse_lines) %>: <strong id="jn-collapse-lines-value"><%= prefs[:collapse_lines] %></strong>
      </label>
      <input type="range" id="jn-collapse-lines" class="jn-settings-slider"
             min="2" max="20" step="1" value="<%= prefs[:collapse_lines] %>">
    </p>

    <div class="jn-settings-subblock" data-jn-block="collapse-autohide">
      <p class="jn-settings-field">
        <label>
          <input type="checkbox" id="jn-collapse-autohide-enabled" <%= 'checked' if prefs[:collapse_autohide_enabled] %>>
          <%= l(:label_jn_collapse_autohide_title) %>
        </label>
      </p>
      <p class="jn-settings-hint"><%= l(:text_jn_collapse_autohide_hint) %></p>
      <p class="jn-settings-field">
        <label for="jn-collapse-autohide-distance">
          <%= l(:label_jn_collapse_autohide_distance) %>: <strong id="jn-collapse-autohide-distance-value"><%= prefs[:collapse_autohide_distance] %></strong>
        </label>
        <input type="range" id="jn-collapse-autohide-distance" class="jn-settings-slider"
               min="2" max="8" step="1" value="<%= prefs[:collapse_autohide_distance] %>">
      </p>
    </div>

    <div class="jn-settings-subblock" data-jn-block="comment-filelist">
      <p class="jn-settings-field">
        <label>
          <input type="checkbox" id="jn-comment-filelist-enabled" <%= 'checked' if prefs[:comment_filelist_enabled] %>>
          <%= l(:label_jn_comment_filelist_title) %>
        </label>
      </p>
      <p class="jn-settings-hint"><%= l(:text_jn_comment_filelist_hint) %></p>
    </div>

    <div class="jn-preview">
      <p class="jn-preview-label"><%= l(:label_jn_preview) %></p>
      <div class="jn-preview-frame" id="jn-preview-history">
        <div class="journal has-notes">
          <h4 class="journal-header">
            <span class="journal-info"><strong>Max Mustermann</strong> &middot; <%= format_time(Time.now - 2.hours) %></span>
          </h4>
          <ul class="details">
            <%
              example_detail_files = [
                ['IMG_4821.jpeg', nil],
                ['IMG_4822.jpeg', nil],
                ['IMG_4823.jpeg', nil],
                ['angebot-tech.pdf', nil],
                ['angebot-tech_a9002_p001.png', 'Seite 1/4 angebot-tech.pdf'],
                ['angebot-tech_a9002_p002.png', 'Seite 2/4 angebot-tech.pdf'],
                ['angebot-tech_a9002_p003.png', 'Seite 3/4 angebot-tech.pdf'],
                ['angebot-tech_a9002_p004.png', 'Seite 4/4 angebot-tech.pdf']
              ]
            %>
            <% example_detail_files.each_with_index do |(name, description), idx| %>
              <li>
                <strong>Datei</strong>
                <a href="/attachments/<%= 9100 + idx %>/<%= name %>"><%= name %></a>
                <%= "(#{description})" if description %>
                wurde hinzugefügt
              </li>
            <% end %>
          </ul>
          <div class="journal-content">
            <div id="journal-preview-notes" class="wiki">
              <p><%= l(:text_jn_example_comment_p1) %></p>
              <p><%= l(:text_jn_example_comment_p2) %></p>
              <p><%= l(:text_jn_example_comment_p3) %></p>
              <ul>
                <li><%= l(:text_jn_example_comment_li1) %></li>
                <li><%= l(:text_jn_example_comment_li2) %></li>
                <li><%= l(:text_jn_example_comment_li3) %></li>
              </ul>
              <p><%= l(:text_jn_example_comment_p4) %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="jn-settings-block" data-jn-block="filelist">
    <h4 class="jn-settings-title">
      <label>
        <input type="checkbox" id="jn-filelist-enabled" <%= 'checked' if prefs[:filelist_enabled] %>>
        <%= l(:label_jn_filelist_title) %>
      </label>
    </h4>
    <p class="jn-settings-hint"><%= l(:text_jn_filelist_hint) %></p>

    <div class="jn-settings-subblock" data-jn-block="filelist-navigator">
      <p class="jn-settings-field">
        <label>
          <input type="checkbox" id="jn-filelist-navigator-enabled" <%= 'checked' if prefs[:filelist_navigator_enabled] %>>
          <%= l(:label_jn_filelist_navigator_title) %>
        </label>
      </p>
      <p class="jn-settings-hint"><%= l(:text_jn_filelist_navigator_hint) %></p>
    </div>

    <div class="jn-preview">
      <p class="jn-preview-label"><%= l(:label_jn_preview) %></p>
      <div class="jn-preview-frame">
        <div id="jn-preview-attachments" class="attachments"
             data-jn-summary="<%= l(:label_jn_attachment_summary, count: 8, size: '9,5 MB') %>">
          <table>
            <%
              example_attachments = [
                ['anforderungen.pdf', '842 KB', 'Anna Beispiel', nil],
                ['architektur-diagramm.png', '1,3 MB', 'Max Mustermann', nil],
                ['protokoll-kickoff.docx', '58 KB', 'Anna Beispiel', nil],
                ['export-logs.zip', '4,1 MB', 'Max Mustermann', nil],
                ['screenshot-bug.png', '210 KB', 'Anna Beispiel', nil],
                ['testplan.xlsx', '96 KB', 'Max Mustermann', nil],
                ['vertrag-entwurf.pdf', '312 KB', 'Anna Beispiel', nil],
                ['vertrag-entwurf_a9001_p001.png', '180 KB', 'Anna Beispiel', 'Seite 1/3 vertrag-entwurf.pdf'],
                ['vertrag-entwurf_a9001_p002.png', '175 KB', 'Anna Beispiel', 'Seite 2/3 vertrag-entwurf.pdf'],
                ['vertrag-entwurf_a9001_p003.png', '190 KB', 'Anna Beispiel', 'Seite 3/3 vertrag-entwurf.pdf'],
                ['mockup-v2.fig', '2,0 MB', 'Max Mustermann', nil]
              ]
            %>
            <% example_attachments.each do |name, size, author, description| %>
              <tr>
                <td>
                  <a href="#" class="icon icon-attachment"><%= name %></a>
                  <span class="size">(<%= size %>)</span>
                </td>
                <td><%= description %></td>
                <td><span class="author"><%= author %></span></td>
                <td></td>
              </tr>
            <% end %>
          </table>
        </div>
      </div>
    </div>
  </div>

  <p id="jn-save-status" class="jn-save-status" aria-live="polite"></p>
</div>
